<!-- Сгенерировано siggen. Требует ревью перед деплоем. -->
<group name="siggen,">
<decoder name="myapp-login">
  <program_name>^myapp$</program_name>
  <prematch>login_failed </prematch>
  <regex offset="after_prematch">^user=(\S+) src=(\S+) attempts=\S+$</regex>
  <order>srcuser, srcip</order>
</decoder>
<rule id="100100" level="10">
  <decoded_as>myapp-login</decoded_as>
  <match>login_failed</match>
  <description>MyApp: повторный неуспешный вход для пользователя $(srcuser) с $(srcip)</description>
  <group>app_auth</group>
  <mitre>
    <id>T1110</id>
  </mitre>
</rule>
</group>
