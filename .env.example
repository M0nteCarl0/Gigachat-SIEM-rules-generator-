# Скопируйте в .env или задайте переменные окружения вручную.
# .env в .gitignore — секреты в репозиторий не попадают.

# --- выбор провайдера модели ---
# fake       — детерминированный офлайн-заглушка для тестов и демо (по умолчанию)
# gigachat   — реальная модель
SIGGEN_PROVIDER=fake

# --- GigaChat (нужен только для SIGGEN_PROVIDER=gigachat) ---
# Авторизационные данные из личного кабинета GigaChat. Никогда не коммитьте.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Проверку TLS отключать нельзя (docs/SECURITY.md, SEC-1). Флаг существует
# только как явное осознанное исключение для отладки в лаборатории.
GIGACHAT_VERIFY_SSL=true

# --- движок валидации ---
SIGGEN_ENGINE=wazuh

# --- диапазон ID пользовательских правил ---
# Уточните под свой менеджер: пользовательские правила не должны задевать
# диапазон встроенного рулсета.
SIGGEN_RULE_ID_MIN=100100
SIGGEN_RULE_ID_MAX=120000
